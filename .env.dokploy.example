# Paste into Dokploy → Application → Environment, then fill blanks.
# Mount (Advanced → Mounts): named volume → /var/www/html/storage/app/private

APP_NAME=RecordPlus
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-domain.example
FRONTEND_URL=https://your-domain.example

# Same public host as APP_URL/FRONTEND_URL (comma-separated if needed)
# SANCTUM_STATEFUL_DOMAINS=your-domain.example

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=error

# GCP Cloud SQL
DB_CONNECTION=mysql
DB_HOST=
DB_PORT=3306
DB_DATABASE=recordplus
DB_USERNAME=
DB_PASSWORD=
# DB_SOCKET=
# MYSQL_ATTR_SSL_CA=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

GEMINI_ENABLED=true
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Defaults to ${FRONTEND_URL}/auth/google/callback
# GOOGLE_REDIRECT_URI=https://your-domain.example/auth/google/callback

ADMIN_EMAIL=

# First deploy only (or run migrate via Dokploy command), then set false
RUN_MIGRATIONS=true
